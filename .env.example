# Copy to .env and fill in. Never commit .env.
# Dev database (Supabase "clinic-queue-dev" project).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres
# Desk login. Generate both with: uv run python -m clinic_queue.security <PIN>
DESK_PIN_HASH=
SECRET_KEY=
# Set to true in production (cookie only sent over HTTPS).
HTTPS_ONLY=false
# Wait estimate (minutes per patient) until today has 3+ finished consults.
DEFAULT_CONSULT_MINUTES=8
# Public address encoded in the printed QR code (production), e.g. https://queue.example.com
PUBLIC_BASE_URL=
# Local Postgres used only by tests. Must be localhost.
TEST_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/postgres
